# Supabase (local defaults shown -- override for hosted Supabase)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Public site origin (task 26). Share cards, canonical URLs, robots.txt and the
# sitemap resolve against it. Unset, it falls back to https://www.zeneratestudio.com,
# so local shares point at production; set it in Vercel to the production
# origin. NEXT_PUBLIC_ values are inlined at build time: redeploy after changing it.
NEXT_PUBLIC_SITE_URL=

# Anthropic (for AI script generation)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Supabase service role key (for server-side storage operations -- from `supabase start` output)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ElevenLabs (for TTS audio generation)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Vercel Sandbox snapshot ID (populated after running scripts/create-sandbox-snapshot.ts)
AUDIO_SANDBOX_SNAPSHOT_ID=

# Audio generation quota (per-user monthly cap and global circuit breaker).
#
# MAX_GLOBAL_AUDIO_GENERATIONS_PER_MONTH is DERIVED FROM THE ELEVENLABS PLAN:
#   Starter (30k credits) / ~930 chars per meditation = ~32, minus headroom = 25
#   Creator (121k credits) would be ~100
# Update it whenever the plan changes, or the circuit breaker will sit above
# the real ceiling and ElevenLabs will cut us off first.
PER_USER_MONTHLY_AUDIO_LIMIT=3
MAX_GLOBAL_AUDIO_GENERATIONS_PER_MONTH=25

# Operator accounts exempt from both audio caps (comma-separated auth user ids).
# Their renders also don't count toward the global total other users draw from,
# so the ElevenLabs credit balance is the only limit on them. Leave empty to
# exempt nobody.
QUOTA_EXEMPT_USER_IDS=

# Studio chat abuse ceiling: user messages per user per rolling 24 hours.
#
# Not a product limit -- normal use never comes near it. It stops a stolen
# session or a runaway client from running up the Anthropic bill. Sized off the
# worst case in src/lib/ai/quota.ts (8000 output tokens x 5 steps per turn).
PER_USER_DAILY_CHAT_MESSAGES=200

# Supabase keepalive cron (see docs/runbooks/backup-restore.md and
# src/app/api/cron/keepalive/route.ts).
#
# Free-plan Supabase projects pause after 7 days of low activity and need a
# MANUAL dashboard restore, so a daily cron keeps the project looking active.
# Vercel sends this value as `Authorization: Bearer $CRON_SECRET` on cron
# invocations. Generate with: openssl rand -hex 32
#
# The route FAILS CLOSED -- if this is unset it returns 503 rather than
# running unauthenticated, so a forgotten variable cannot leave an open
# endpoint pointed at the database. It also means the cron does nothing until
# this is set in Vercel.
CRON_SECRET=

# Optional dead-man's-switch. If set, the keepalive POSTs here after a
# successful database read.
#
# Vercel's logs can show a run that FAILED. They cannot show a run that never
# happened -- cron disabled, vercel.json dropped by a deploy, project already
# paused. Those are the cases that actually bite, because they fail silently
# and exactly when nobody is looking. Point this at a healthchecks.io-style
# URL and you get alerted when the pings stop. Leave empty to skip entirely.
KEEPALIVE_PING_URL=
